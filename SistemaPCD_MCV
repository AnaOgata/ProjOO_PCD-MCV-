using System;
using System.Collections.Generic;

public class EventoMedicao
{
    public string IdPCD         { get; }
    public string NomePCD       { get; }
    public string Rio           { get; }
    public string Regiao        { get; }
    public string TipoMedicao   { get; }
    public double ValorAnterior { get; }
    public double ValorAtual    { get; }

    public EventoMedicao(string idPCD, string nomePCD, string rio, string regiao,
                         string tipoMedicao, double valorAnterior, double valorAtual)
    {
        IdPCD         = idPCD;
        NomePCD       = nomePCD;
        Rio           = rio;
        Regiao        = regiao;
        TipoMedicao   = tipoMedicao;
        ValorAnterior = valorAnterior;
        ValorAtual    = valorAtual;
    }
}

public interface IObservadorPCD
{
    //CALLBACK — chamado pela PCD
    void MedicaoAlterada(EventoMedicao evento);
}

public interface ISujeitoPCD
{
    void Inscrever(IObservadorPCD observador);
    void Cancelar(IObservadorPCD observador);
}

public class PCD : ISujeitoPCD
{
    public string Id     { get; }
    public string Nome   { get; }
    public string Rio    { get; }
    public string Regiao { get; }

    private double _temperaturaAgua;
    private double _phAgua;
    private double _umidadeRelativa;

    //Lista de observadores 
    //[SUJEITO] agrega [OBSERVADOR] via interface → desacoplamento total
    private readonly List<IObservadorPCD> _observadores = new List<IObservadorPCD>();

    public PCD(string id, string nome, string rio, string regiao,
               double temperaturaAgua, double phAgua, double umidadeRelativa)
    {
        Id               = id;
        Nome             = nome;
        Rio              = rio;
        Regiao           = regiao;
        _temperaturaAgua = temperaturaAgua;
        _phAgua          = phAgua;
        _umidadeRelativa = umidadeRelativa;
    }

    //disparam o callback automaticamente ao mudar
    public double TemperaturaAgua
    {
        get => _temperaturaAgua;
        set
        {
            double anterior  = _temperaturaAgua;
            _temperaturaAgua = value;
            if (Math.Abs(anterior - value) > 1e-9)
                NotificarObservadores("Temperatura da Água (°C)", anterior, value); // ← IoC automático
        }
    }

    public double PhAgua
    {
        get => _phAgua;
        set
        {
            double anterior = _phAgua;
            _phAgua         = value;
            if (Math.Abs(anterior - value) > 1e-9)
                NotificarObservadores("pH da Água", anterior, value); // ← IoC automático
        }
    }

    public double UmidadeRelativa
    {
        get => _umidadeRelativa;
        set
        {
            double anterior  = _umidadeRelativa;
            _umidadeRelativa = value;
            if (Math.Abs(anterior - value) > 1e-9)
                NotificarObservadores("Umidade Relativa do Ar (%)", anterior, value); // ← IoC automático
        }
    }

    public void Inscrever(IObservadorPCD observador)
    {
        if (!_observadores.Contains(observador))
        {
            _observadores.Add(observador);
            Console.WriteLine($"  [+] Observador inscrito em {Nome}");
        }
    }

    public void Cancelar(IObservadorPCD observador)
    {
        _observadores.Remove(observador);
        Console.WriteLine($"  [-] Observador cancelou inscrição em {Nome}");
    }

    private void NotificarObservadores(string tipoMedicao,
                                       double valorAnterior, double valorAtual)
    {
        Console.WriteLine($"\n  [{Nome}] Mudança detectada em '{tipoMedicao}':" +
                          $" {valorAnterior:F2} → {valorAtual:F2}");
        Console.WriteLine($"     Notificando {_observadores.Count} observador(es)...");

        var evento = new EventoMedicao(Id, Nome, Rio, Regiao,
                                       tipoMedicao, valorAnterior, valorAtual);

        //CALLBACK disparado — IoC: quem controla o fluxo é o Sujeito
        foreach (var obs in _observadores)
            obs.MedicaoAlterada(evento);
        //O Sujeito chama o método do Observador.
        //O Observador nunca chamou o Sujeito para obter esta informação.
        //Isso é Inversão de Controle.
    }

    public override string ToString() =>
        $"PCD [{Id}] {Nome} | Rio: {Rio} | Região: {Regiao} " +
        $"| T°C: {_temperaturaAgua:F1} | pH: {_phAgua:F1} | Umidade: {_umidadeRelativa:F1}%";
}

public class Universidade : IObservadorPCD
{
    public string Nome   { get; }
    public string Cidade { get; }

    public Universidade(string nome, string cidade)
    {
        Nome   = nome;
        Cidade = cidade;
    }

    //CALLBACK — implementação do contrato IObservadorPCD
    public void MedicaoAlterada(EventoMedicao evento)
    {
        Console.WriteLine($"    [{Nome} - {Cidade}] " +
                          $"Notificação recebida: '{evento.TipoMedicao}' " +
                          $"da {evento.NomePCD} ({evento.Rio}, {evento.Regiao}) " +
                          $"mudou de {evento.ValorAnterior:F2} para {evento.ValorAtual:F2}.");
    }

    public override string ToString() => $"Universidade {Nome} ({Cidade})";
}

public class AlertaClimatico : IObservadorPCD
{
    private readonly double _limiarTemperatura;

    public AlertaClimatico(double limiarTemperatura)
    {
        _limiarTemperatura = limiarTemperatura;
    }

    //CALLBACK — implementação própria do contrato IObservadorPCD
    public void MedicaoAlterada(EventoMedicao evento)
    {
        if (evento.TipoMedicao.StartsWith("Temperatura") &&
            evento.ValorAtual > _limiarTemperatura)
        {
            Console.WriteLine($"    *** [ALERTA CLIMÁTICO] {evento.NomePCD}: " +
                              $"temperatura {evento.ValorAtual:F1}°C excede o limiar " +
                              $"de {_limiarTemperatura:F1}°C! ***");
        }
    }
}

class Program
{
    static void Main()
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;

        Cabecalho("SISTEMA DE MONITORAMENTO DE PCDs NA AMAZÔNIA");

        Secao("1. Instanciando os Sujeitos (PCDs)");

        var pcdSolimoes = new PCD("PCD-AM-001", "PCD Solimões I",
                                  "Rio Solimões", "Amazonas",
                                  28.5, 6.8, 85.0);

        var pcdNegro    = new PCD("PCD-AM-002", "PCD Negro II",
                                  "Rio Negro", "Amazonas",
                                  27.0, 4.2, 90.0);

        var pcdXingu    = new PCD("PCD-PA-001", "PCD Xingu I",
                                  "Rio Xingu", "Pará",
                                  29.2, 7.1, 82.0);

        Console.WriteLine($"  {pcdSolimoes}");
        Console.WriteLine($"  {pcdNegro}");
        Console.WriteLine($"  {pcdXingu}");

        Secao("2. Instanciando os Observadores");

        var inpe  = new Universidade("INPE",  "São José dos Campos");
        var ufrj  = new Universidade("UFRJ",  "Rio de Janeiro");
        var usp   = new Universidade("USP",   "São Paulo");
        var ufpr  = new Universidade("UFPR",  "Curitiba");
        var ufam  = new Universidade("UFAM",  "Manaus");
        var alerta = new AlertaClimatico(limiarTemperatura: 30.0);

        Console.WriteLine($"  {inpe}");
        Console.WriteLine($"  {ufrj}");
        Console.WriteLine($"  {usp}");
        Console.WriteLine($"  {ufpr}");
        Console.WriteLine($"  {ufam}");
        Console.WriteLine($"  AlertaClimatico (limiar 30.0°C)");

        Secao("3. Registrando Observadores nos Sujeitos (Inscrever)");

        Console.WriteLine("\n  → Interesses na PCD Solimões I:");
        pcdSolimoes.Inscrever(inpe);
        pcdSolimoes.Inscrever(usp);
        pcdSolimoes.Inscrever(ufam);
        pcdSolimoes.Inscrever(alerta);

        Console.WriteLine("\n  → Interesses na PCD Negro II:");
        pcdNegro.Inscrever(ufrj);
        pcdNegro.Inscrever(ufam);
        pcdNegro.Inscrever(ufpr);
        pcdNegro.Inscrever(alerta);

        Console.WriteLine("\n  → Interesses na PCD Xingu I:");
        pcdXingu.Inscrever(inpe);
        pcdXingu.Inscrever(ufrj);
        pcdXingu.Inscrever(usp);

        Secao("4. Simulando mudanças — Callbacks disparados automaticamente (IoC)");

        Console.WriteLine("\n Alterando temperatura da PCD Solimões I de 28.5°C para 31.2°C:");
        pcdSolimoes.TemperaturaAgua = 31.2;

        Console.WriteLine("\n Alterando pH da PCD Negro II de 4.2 para 3.9:");
        pcdNegro.PhAgua = 3.9;

        Console.WriteLine("\n Alterando umidade relativa da PCD Xingu I de 82.0% para 76.5%:");
        pcdXingu.UmidadeRelativa = 76.5;

        Console.WriteLine("\n Alterando temperatura da PCD Negro II de 27.0°C para 29.8°C:");
        pcdNegro.TemperaturaAgua = 29.8;

        Console.WriteLine("\n Alterando pH da PCD Xingu I de 7.1 para 7.4:");
        pcdXingu.PhAgua = 7.4;

        Secao("5. Cancelamento de inscrição (de-registering)");

        pcdNegro.Cancelar(ufam);
        Console.WriteLine("\n Temperatura do Negro sobe para 30.5°C — UFAM NÃO deve ser notificada:");
        pcdNegro.TemperaturaAgua = 30.5;

        Secao("6. Estado final dos Sujeitos");

        Console.WriteLine($"  {pcdSolimoes}");
        Console.WriteLine($"  {pcdNegro}");
        Console.WriteLine($"  {pcdXingu}");

        Console.WriteLine("\n" + new string('=', 70));
        Console.WriteLine("  Simulação concluída com sucesso.");
        Console.WriteLine(new string('=', 70));
    }

    static void Cabecalho(string texto)
    {
        Console.WriteLine(new string('=', 70));
        Console.WriteLine($"  {texto}");
        Console.WriteLine(new string('=', 70));
    }

    static void Secao(string texto)
    {
        Console.WriteLine($"\n{new string('─', 70)}");
        Console.WriteLine($"  {texto}");
        Console.WriteLine(new string('─', 70));
    }
}
